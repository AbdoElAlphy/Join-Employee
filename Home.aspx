<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Home.aspx.cs" Inherits="JoinEmp.WebForm1" ResponseEncoding="utf-8" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <meta charset="utf-8" />

    <title>CPC - Corporate Placement Consultants</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
        }

        body {
            font-family: Arial, sans-serif;
            background: #06172c;
            color: white;
            overflow: hidden;
        }


        /* =========================================
           ANIMATED BACKGROUND
        ========================================== */

        #particlesCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }


        .background-glow {
            position: fixed;
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(40, 120, 220, 0.18) 0%, rgba(20, 70, 150, 0.08) 40%, transparent 70%);
            filter: blur(30px);
            animation: moveGlow 15s ease-in-out infinite alternate;
            z-index: 1;
            pointer-events: none;
        }

        @keyframes moveGlow {
            0% { transform: translate(-100px, -80px); }
            100% { transform: translate(900px, 300px); }
        }

        .gold-glow {
            position: fixed;
            width: 500px;
            height: 500px;
            right: -100px;
            bottom: -100px;
            background: radial-gradient(circle, rgba(235, 190, 80, 0.14), transparent 70%);
            filter: blur(30px);
            animation: goldMove 12s ease-in-out infinite alternate;
            z-index: 1;
            pointer-events: none;
        }

        @keyframes goldMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-250px, -180px); }
        }


        /* =========================================
           WAVE DECORATION
        ========================================== */

        .wave-decor {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 180px;
            z-index: 2;
            opacity: 0.7;
            pointer-events: none;
        }


        /* =========================================
           MAIN PAGE
        ========================================== */

        .page {
            position: relative;
            z-index: 5;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }


        /* =========================================
           NAVBAR
        ========================================== */

        .navbar {
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
            border-bottom: 1px solid rgba(255,255,255,0.12);
            background: rgba(5, 20, 40, 0.30);
            backdrop-filter: blur(10px);
        }

        .logo img {
            height: 40px;
            width: auto;
            display: block;
        }

        .nav-links {
            display: flex;
            gap: 45px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: 0.3s;
            position: relative;
        }

        .nav-links a:hover { color: #e6bd61; }

        .nav-links a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -10px;
            width: 0;
            height: 2px;
            background: #e6bd61;
            transition: 0.3s;
        }

        .nav-links a:hover::after { width: 100%; }

        .tagline {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 13px;
            font-style: italic;
            color: #c9d4e3;
            line-height: 1.35;
            text-align: left;
        }

        .tagline .divider {
            width: 1px;
            height: 34px;
            background: rgba(230,189,97,0.6);
        }


        /* =========================================
           HERO SECTION
        ========================================== */

        .hero {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 30px 10%;
            position: relative;
        }

        .hero-left {
            max-width: 650px;
            animation: fadeUp 1.3s ease;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hero-logo {
            margin-bottom: 26px;
        }

        .hero-logo img {
            height: 62px;
            width: auto;
            display: block;
        }

        .small-title {
            font-size: 20px;
            color: #e5bb61;
            letter-spacing: 2px;
            margin-bottom: 18px;
        }

        .hero h1 {
            font-size: 65px;
            line-height: 1.05;
            margin-bottom: 20px;
        }

        .hero h1 span { color: #e6bd61; }

        .hero h2 {
            font-size: 28px;
            font-weight: normal;
            color: #d9e1ee;
            margin-bottom: 22px;
        }

        .hero p {
            color: #b9c6d8;
            font-size: 17px;
            line-height: 1.7;
            max-width: 600px;
            margin-bottom: 35px;
        }


        /* =========================================
           BUTTONS
        ========================================== */

        .buttons {
            display: flex;
            gap: 20px;
        }

        .btn {
            width: 190px;
            height: 55px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 26px;
            text-decoration: none;
            font-size: 16px;
            font-weight: bold;
            transition: 0.35s;
        }

        .btn .arrow {
            font-size: 18px;
            transition: transform 0.3s;
        }

        .btn:hover .arrow { transform: translateX(4px); }

        .login {
            border: 2px solid #e6bd61;
            color: white;
            background: rgba(0,0,0,0.12);
        }

        .register {
            background: linear-gradient(135deg, #f4d37f, #d9a93d);
            color: #07182b;
            box-shadow: 0 0 25px rgba(230,189,97,0.20);
        }

        .btn:hover { transform: translateY(-4px) scale(1.02); }

        .login:hover { background: #e6bd61; color: #06172c; }

        .register:hover { box-shadow: 0 0 35px rgba(230,189,97,0.45); }


        /* =========================================
           RIGHT SIDE VISUAL
        ========================================== */

        .hero-right {
            width: 460px;
            height: 460px;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .circle {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(230,189,97,0.35);
            animation: rotateCircle 18s linear infinite;
        }

        .circle::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: conic-gradient(from 0deg, transparent 0%, rgba(230,189,97,0.95) 6%, rgba(230,189,97,0.15) 14%, transparent 26%);
            -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
        }

        .circle1 { width: 400px; height: 400px; }
        .circle1::after { animation: rotateCircle 7s linear infinite; }

        .circle2 {
            width: 300px;
            height: 300px;
            animation-duration: 13s;
            animation-direction: reverse;
        }
        .circle2::after { animation: rotateCircle 5s linear infinite reverse; }

        .circle3 { width: 190px; height: 190px; animation-duration: 9s; }
        .circle3::after { display: none; }

        @keyframes rotateCircle {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .center-icon {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle, rgba(70,135,205,0.55) 0%, rgba(15,45,80,0.25) 65%, transparent 100%);
            box-shadow: 0 0 55px rgba(70,150,230,0.30);
            animation: pulse 4s ease-in-out infinite;
            z-index: 3;
            color: #a9c8ec;
        }

        .center-icon svg { width: 200px; height: 80px; }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.07); }
        }

        .icon-circle {
            position: absolute;
            width: 62px;
            height: 62px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle, rgba(25,60,105,0.95), rgba(5,20,40,0.95));
            border: 1.5px solid rgba(230,189,97,0.65);
            box-shadow: 0 0 20px rgba(0,0,0,0.45);
            z-index: 4;
            animation: float1 6s ease-in-out infinite;
            color: #dbe6f5;
        }

        .icon-circle svg { width: 26px; height: 26px; }

        .icon-briefcase { top: 15px; right: 55px; }

        .icon-document {
            top: 165px;
            right: -20px;
            animation: float2 7s ease-in-out infinite;
        }

        .icon-group-small {
            bottom: 115px;
            left: -20px;
            animation: float3 5s ease-in-out infinite;
        }

        .icon-search {
            bottom: 35px;
            right: 65px;
            animation: float1 5.5s ease-in-out infinite;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            position: absolute;
            background: #e6bd61;
            box-shadow: 0 0 15px #e6bd61;
        }

        .dot1 { top: 40px; left: 90px; animation: float1 5s ease-in-out infinite; }

        .dot2 {
            left: 10px;
            bottom: 60px;
            background: #4ba4ff;
            box-shadow: 0 0 15px #4ba4ff;
            animation: float2 6s ease-in-out infinite;
        }

        .dot3 { right: 30px; bottom: 190px; animation: float3 4s ease-in-out infinite; }

        @keyframes float1 {
            0%,100% { transform: translateY(0); }
            50% { transform: translateY(-16px); }
        }

        @keyframes float2 {
            0%,100% { transform: translate(0,0); }
            50% { transform: translate(12px,-12px); }
        }

        @keyframes float3 {
            0%,100% { transform: translateY(0); }
            50% { transform: translateY(16px); }
        }


        /* =========================================
           FOOTER
        ========================================== */

        .footer {
            height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 7%;
            border-top: 1px solid rgba(255,255,255,0.12);
            color: #91a2b8;
            font-size: 12px;
            background: rgba(5,20,40,0.25);
            backdrop-filter: blur(8px);
            position: relative;
            z-index: 6;
        }


        /* =========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 1000px) {
            .hero { padding: 40px 5%; }
            .tagline { display: none; }
            .hero-right { width: 350px; height: 350px; }
            .circle1 { width: 320px; height: 320px; }
            .circle2 { width: 240px; height: 240px; }
            .hero h1 { font-size: 50px; }
        }

        @media (max-width: 750px) {
            body { overflow-y: auto; }
            .nav-links { display: none; }
            .hero { flex-direction: column; text-align: center; padding-top: 70px; }
            .hero-left { max-width: 100%; }
            .hero-logo, .hero p { margin-left: auto; margin-right: auto; }
            .hero-logo { display: flex; justify-content: center; }
            .buttons { justify-content: center; }
            .hero-right { margin-top: 50px; transform: scale(0.8); }
            .footer { display: none; }
            .wave-decor { display: none; }
        }

    </style>

</head>


